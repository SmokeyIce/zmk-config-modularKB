#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
//chosen
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };


//kscan
    // PIN MAPPING KEYPAD

    kscan0: kscan0 { 
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 31
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 32
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 33
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 34
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 35
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 36
            

            //, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // ROT A
            //, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // ROT B
            //, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // ROT C

            ;
        col-gpios 
            = <&pro_micro 19 GPIO_ACTIVE_HIGH > // column 31
            , <&pro_micro 18 GPIO_ACTIVE_HIGH > // column 32
            , <&pro_micro 14 GPIO_ACTIVE_HIGH > // column 33
            , <&pro_micro 15 GPIO_ACTIVE_HIGH > // column 34
            ;
    };



//transform
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        col-offset = <20>;
        columns = <24>;
        rows = <6>;
        map = <
            RC(0,20) RC(0,21) RC(0,22) RC(0,23) //row 1
            RC(1,20) RC(1,21) RC(1,22) RC(1,23) //row 2
            RC(2,20) RC(2,21) RC(2,22)          //row 3
            RC(3,20) RC(3,21) RC(3,22) RC(3,23) //row 4
            RC(4,20) RC(4,21) RC(4,22)          //row 5
            RC(5,20)          RC(5,22) RC(5,23) //row 6
        >;
    };


//physcial layout

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };


//led and indicators
    // development verison, cant use the library in 0.3V
    leds {
        compatible = "gpio-leds";

        num_lock_led: num_lock{
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        };
    };

    indicators {
            compatible = "zmk,indicator-leds";

            num_lock_indicator: num_lock {
                indicator = <HID_INDICATOR_NUM_LOCK>;
                leds = <&num_lock_led>;
            };
    };

};


