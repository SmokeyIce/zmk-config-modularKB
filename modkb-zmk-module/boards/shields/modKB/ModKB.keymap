
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {
    keymap {
        compatible = "zmk,keymap";
    
        default_layer {
			display-name = "Base";
        // -----------------------------------------------------------------------------------------
        // |  A  |  B  |  C  |
        // |  1  |  2  |  3  |
        // |  4  |  5  |  6  |
        // |  7  |  8  |  9  |
        // |  0  |     | ENT |
            bindings = <
                &kp A       &kp B       &kp C
                &kp KP_N1   &kp KP_N2   &kp KP_N3 
                &kp KP_N4   &kp KP_N5   &kp KP_N16 
                &kp KP_N7   &kp KP_N8   &kp KP_N9  
                &kp KP_N0               &kp KP_NUM
            >;
        };  
	};
};
