
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>


/ {
    keymap{
        compatible = "zmk,keymap";
        
        default_layer {
			display-name = "Base";
        // -----------------------------------------------------------------------------------------------------------------------------------------------
        // | M1 | | ESC |     |  F1  | F2  | F3  | F4  | | F5  | F6  | F7  | F8  | | F9  | F10 | F11 | F12 | | PSCRN|SCLLCK|PSEBREAK | |  BK | PSE | FW  | EC11|
        // |    | |     |     |----------------------------------------------------------------------------| |                       | |-----------------------|
        // | M2 | |GRAVE|  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BSPC   | |  INS  | HOME |  PGUP  | | NUM |  /  |  *  |  -  |
        // | M3 | | TAB   |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   \    | |  DLT  |  END |  PGDN  | |  7  |  8  |  9  |  +  |
        // | M4 | | CAPS   |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |    ENTER    | |                       | |  4  |  5  |  6  |     |
        // | M5 | |  SHIFT   |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |   SHIFT         | |       |  UP  |        | |  1  |  2  |  3  |     |
        // | M6 | |  CTL  |  WIN  |  ALT  |    SPACE    | |      SPACE     | ALT  |  WIN  |MENU| CTRL|     | |   LEFT| DOWN | RIGHT  | |  0        | DEL | ENT |
            bindings = <
                    &kp N1      &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12       &kp PSCRN &kp SLCK   &kp PAUSE_BREAK  
                    &kp N2      &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL             &kp BSPC      &kp INS   &kp HOME   &kp PG_UP       
            &kp N3   &kp U       &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT              &kp BSLH      &kp DEL   &kp END    &kp PG_DN        
                    &kp N4       &kp J      &kp K      &kp L      &kp SEMI   &kp SQT               &kp RET                                             
                                &kp N5      &kp M      &kp COMMA  &kp DOT    &kp FSLH              &kp RSHFT                &kp UP                     
                                           &kp N6             &kp RALT   &kp RGUI  &kp K_MENU  &kp RCTRL     &kp LEFT &kp DOWN &kp RIGHT          
            >;
            //         RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)  RC(0,8) RC(0,9) RC(0,10) RC(0,11) //row 1
            //         RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)          RC(1,8) RC(1,9) RC(1,10) RC(1,11) //row 2
            // RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)          RC(2,8) RC(2,9) RC(2,10) RC(2,11) //row 3
            //         RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)          RC(3,8)                           //row 4
            //                 RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)          RC(4,8)         RC(4,10)          //row 5
            //                         RC(5,3)         RC(5,5) RC(5,6) RC(5,7)  RC(5,8) RC(5,9) RC(5,10) RC(5,11) //row 6  

	    };
    };
};
