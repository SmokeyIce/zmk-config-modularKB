
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {
    keymap{
        compatible = "zmk,keymap";
    
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        
        default_layer {
			display-name = "Base";
        // -----------------------------------------------------------------------------------------------------------------------------------------------
        // | M1 | | ESC |     |  F1  | F2  | F3  | F4  | | F5  | F6  | F7  | F8  | | F9  | F10 | F11 | F12 | | PSCRN|SCLLCK|PSEBREAK | |  A  |  B  |  C  |
           |    | |     |     |----------------------------------------------------------------------------| |                       | |-----------------|
        // | M2 | |GRAVE|  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BSPC   | |  INS  | HOME |  PGUP  | |  1  |  2  |  3  |
        // | M3 | | TAB   |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   \    | |  DLT  |  END |  PGDN  | |  4  |  5  |  6  |
        // | M4 | | CAPS   |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |    ENTER    | |                       | |  7  |  8  |  9  |
        // | M5 | |  SHIFT   |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |   SHIFT         | |       |  UP  |        | |  0  |     | ENT |
        // | M6 | |  CTL  |  WIN  |  ALT  |    SPACE    | |      SPACE     | ALT  |  WIN  |MENU| CTRL|     | |   LEFT| DOWN | RIGHT  | |
            bindings =<
                &M1 &kp ESC     &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp  F8   &kp  F9 &kp  F10  &kp F11 &kp F12                 &kp A      &kp B       &kp C
                &M2 &KP GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp  N8   &kp  N9   &kp N0 &kp MINUS &kp EQUAL &kp BSPC      &kp KP_N1   &kp KP_N2   &kp KP_N3 
                &M3 &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp  I    &kp  O  &kp  P   &kp LBKT &kp RBKT &kp BSLH        &kp KP_N4   &kp KP_N5   &kp KP_N6 
                &M4 &kp CLCK   &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp  K    &kp  L  &kp SEMI &kp SQT         &kp RET          &kp KP_N7   &kp KP_N8   &kp KP_N9  
                &M5 &kp LSHFT     &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH   &kp RSHFT                   &kp KP_N0               &kp KP_NUM
                &M6 &kp LCTRL &kp LGUI &kp LALT     &kp SPACE      &kp SPACE          &kp RALT  &mo 1 &kp RCTRL
            >;
        };  
	};
};
