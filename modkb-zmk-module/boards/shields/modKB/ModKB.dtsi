#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
                RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)  RC(0,8) RC(0,9) RC(0,10) RC(0,11) //row 1
                RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)          RC(1,8) RC(1,9) RC(1,10) RC(1,11) //row 2
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)          RC(2,8) RC(2,9) RC(2,10) RC(2,11) //row 3
                RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)          RC(3,8)                            //row 4
                        RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)          RC(4,8)         RC(4,10)          //row 5
                                RC(5,3)         RC(5,5) RC(5,6) RC(5,7)  RC(5,8) RC(5,9) RC(5,10) RC(5,11) //row 6
        >;
    };

// PHYSICAL LAYOUT

    physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default layout";
        transform = <&default_transform>;
    };

// BATTERY
    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

};

//for battery
&reg0 {
    status = "okay";

};