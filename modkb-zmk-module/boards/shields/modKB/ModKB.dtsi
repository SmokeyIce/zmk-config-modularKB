#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) //row 1
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) //row 2
            RC(2,0) RC(2,1) RC(2,2)         //row 3
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) //row 4
            RC(4,0) RC(4,1) RC(4,2)         //row 5
            RC(5,0)         RC(5,2) RC(5,3) //row 6
        >;
    };

// PHYSICAL LAYOUT

    physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default layout";
        transform = <&default_transform>;
    };

// BATTERY
    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

};

//for battery
&reg0 {
    status = "okay";
};