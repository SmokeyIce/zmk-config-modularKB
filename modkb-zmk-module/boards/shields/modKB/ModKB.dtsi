#include <dt-bindings/zmk/matrix_transform.h>


/ {
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1)         RC(0,3) RC(0,4) RC(0,5) RC(0,6)            //row 1
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)    //row 2
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)            //row 3
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)            //row 4
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)            //row 5
            RC(5,0) RC(5,1) RC(5,2) RC(5,3)                 RC(5,6)            //row 6
        >;
    };

    physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default layout";
        transform = <&default_transform>;
    };

// battery
    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

};

&reg0{
    status = "okay";
};