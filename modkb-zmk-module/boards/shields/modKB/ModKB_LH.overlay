#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
//chosen
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };


//kscan
    // PIN MAPPING LEFT HALF

    // diode move col2row or row2col?

    kscan0: kscan0 { 
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 1
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 2
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 3
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 4
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 5
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 6
            ;
        col-gpios 
            = <&pro_micro 6 GPIO_ACTIVE_HIGH > // column 1
            , <&pro_micro 7 GPIO_ACTIVE_HIGH > // column 2
            , <&pro_micro 8 GPIO_ACTIVE_HIGH > // column 3
            , <&pro_micro 9 GPIO_ACTIVE_HIGH > // column 4
            , <&pro_micro 10 GPIO_ACTIVE_HIGH > // column 5
            , <&pro_micro 16 GPIO_ACTIVE_HIGH > // column 6
            , <&pro_micro 14 GPIO_ACTIVE_HIGH > // column 7
            , <&pro_micro 15 GPIO_ACTIVE_HIGH > // column 8
            ;
    };


//transform

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7)
        >;
    };


//physical layout

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default layout";
        transform = <&default_transform>;
    };


//led and idicators
    // development verison, cant use the library in 0.3V
    leds {
        compatible = "gpio-leds";

        caps_lock_led: caps_lock_led {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        };
    };

    indicators {
            compatible = "zmk,indicator-leds";

            caps_lock_indicator: caps_lock {
                indicator = <HID_INDICATOR_CAPS_LOCK>;
                leds = <&caps_lock_led>;
            };
    };

};
