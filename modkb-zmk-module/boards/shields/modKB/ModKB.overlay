#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
//chosen

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };


//kscan 
    // PIN MAPPING
    // Which pins are active, sectioned by row-column, diode move col2row

    //KEY PAD ONLY
    kscan0: kscan0 { 
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 1
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 2
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 3
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 4
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) > // row 5
            ;
        col-gpios 
            = <&pro_micro 19 GPIO_ACTIVE_HIGH > // column 1
            , <&pro_micro 18 GPIO_ACTIVE_HIGH > // column 2
            , <&pro_micro 14 GPIO_ACTIVE_HIGH > // column 3
            ;
    };

//transform
    // #include "matrix_transform.h" defines row coulmn like this

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) 
            RC(1,0) RC(1,1) RC(1,2) 
            RC(2,0) RC(2,1) RC(2,2) 
            RC(3,0) RC(3,1) RC(3,2) 
            RC(4,0)         RC(4,2) 
        >;
    };


//physical layout
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default layout";
        transform = <&default_transform>;
    };


//led and indicators
    // development verison, cant use the library in 0.3V
    leds {
        compatible = "gpio-leds";

        num_lock_led: num_lock{
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        };
    };

    indicators {
            compatible = "zmk,indicator-leds";

            num_lock_indicator: num_lock {
                indicator = <HID_INDICATOR_NUM_LOCK>;
                leds = <&num_lock_led>;
            };
    };

};
