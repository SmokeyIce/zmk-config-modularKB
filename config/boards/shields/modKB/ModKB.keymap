


#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
			display-name = "Base";
        // -----------------------------------------------------------------------------------------
        // |  A  |  B  |  C  |
        // |  1  |  2  |  3  |
        // |  4  |  5  |  6  |
        // |  7  |  8  |  9  |
        // |  0  |     | ENT |
            bindings = <
                &kp A   &kp B   &kp C
                &kp 1   &kp 2   &kp 3 
                &kp 4   &kp 5   &kp 6 
                &kp 7   &kp 8   &kp 9  
                &kp 0           &kp RET
            >;
        };  
	};
};
